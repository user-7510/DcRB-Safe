
import pickle ,base64 ,gzip ,subprocess ,sys ,tempfile ,os 


payload =""""""


pickled =base64 .b64decode (payload .encode ("ascii"))
compressed =pickle .loads (pickled )
data =gzip .decompress (compressed )


fd ,path =tempfile .mkstemp (suffix =".py",text =False )
os .close (fd )
with open (path ,"wb")as f :
    f .write (data )

print (f"Wrote to {path }. Executing with Python...")







exec (compile (data .decode ('utf-8'),path ,'exec'))
